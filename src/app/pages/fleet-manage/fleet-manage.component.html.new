<div class="min-h-screen bg-gray-50 p-6">
  <div class="w-full">
    
    <!-- Header Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 flex items-center">
            <i class="fas fa-truck text-blue-600 text-3xl mr-3"></i>
            Fleet Management System
          </h1>
          <p class="text-gray-600 mt-2">Al Farah Contracting & General Transport - 600+ Vehicles</p>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">Last Updated</p>
          <p class="text-sm font-medium text-gray-900">{{ getCurrentDateTime() }}</p>
          <div class="flex space-x-2 mt-2">
            <button (click)="refreshData()" class="px-3 py-1 text-xs bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200">
              Refresh
            </button>
            <button (click)="exportData()" class="px-3 py-1 text-xs bg-green-100 text-green-700 rounded-md hover:bg-green-200">
              Export
            </button>
            <button (click)="printReport()" class="px-3 py-1 text-xs bg-purple-100 text-purple-700 rounded-md hover:bg-purple-200">
              Print
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-truck text-blue-600 text-xl"></i>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Total Vehicles</p>
            <p class="text-2xl font-bold text-blue-600">{{ totalVehicles }}</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-check-circle text-green-600 text-xl"></i>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Available</p>
            <p class="text-2xl font-bold text-green-600">{{ availableVehicles }}</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-play-circle text-blue-600 text-xl"></i>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">In Use</p>
            <p class="text-2xl font-bold text-blue-600">{{ inUseVehicles }}</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-yellow-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-tools text-yellow-600 text-xl"></i>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Maintenance</p>
            <p class="text-2xl font-bold text-yellow-600">{{ maintenanceVehicles }}</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-red-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Breakdown</p>
            <p class="text-2xl font-bold text-red-600">{{ breakdownVehicles }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="bg-white rounded-lg shadow-md border border-gray-200 mb-8">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex space-x-8 px-6">
          <button 
            (click)="switchTab('overview')"
            [class]="selectedTab === 'overview' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            Overview
          </button>
          <button 
            (click)="switchTab('vehicles')"
            [class]="selectedTab === 'vehicles' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            Vehicles
          </button>
          <button 
            (click)="switchTab('fuel')"
            [class]="selectedTab === 'fuel' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            Fuel
          </button>
          <button 
            (click)="switchTab('routes')"
            [class]="selectedTab === 'routes' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            Routes
          </button>
          <button 
            (click)="switchTab('maintenance')"
            [class]="selectedTab === 'maintenance' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            Maintenance
          </button>
        </nav>
      </div>
    </div>

    <!-- Overview Tab -->
    <div *ngIf="selectedTab === 'overview'" class="space-y-8">
      
      <!-- Quick Actions -->
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <button (click)="openAddVehicleModal()" class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-colors">
            <div class="text-center">
              <i class="fas fa-plus-circle text-gray-400 text-2xl mx-auto mb-2"></i>
              <p class="text-sm font-medium text-gray-700">Add Vehicle</p>
            </div>
          </button>
          <button (click)="openFuelEntryModal()" class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-green-500 hover:bg-green-50 transition-colors">
            <div class="text-center">
              <i class="fas fa-gas-pump text-gray-400 text-2xl mx-auto mb-2"></i>
              <p class="text-sm font-medium text-gray-700">Fuel Entry</p>
            </div>
          </button>
          <button (click)="openServiceModal()" class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-yellow-500 hover:bg-yellow-50 transition-colors">
            <div class="text-center">
              <i class="fas fa-wrench text-gray-400 text-2xl mx-auto mb-2"></i>
              <p class="text-sm font-medium text-gray-700">Schedule Service</p>
            </div>
          </button>
          <button (click)="openDriverAssignModal()" class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition-colors">
            <div class="text-center">
              <i class="fas fa-user-plus text-gray-400 text-2xl mx-auto mb-2"></i>
              <p class="text-sm font-medium text-gray-700">Assign Driver</p>
            </div>
          </button>
        </div>
      </div>

      <!-- Vehicle Status Overview -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Vehicle Status Distribution</h3>
          <div class="space-y-4">
            <div *ngFor="let status of vehicleStatuses" class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="w-4 h-4 rounded-full mr-3" [class]="status.bgColor.replace('bg-', 'bg-').replace('-100', '-500')"></div>
                <span class="text-sm font-medium text-gray-700">{{ status.name }}</span>
              </div>
              <span class="text-sm font-bold" [class]="status.color">{{ getVehiclesByStatus(status.name).length }}</span>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Fuel Entries</h3>
          <div class="space-y-3">
            <div *ngFor="let record of fuelRecords.slice(0, 5)" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <div>
                <p class="text-sm font-medium text-gray-900">AF-{{ record.vehicleId }}</p>
                <p class="text-xs text-gray-500">{{ formatDate(record.date) }} at {{ record.time }}</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-green-600">{{ record.fuelAmount }}L</p>
                <p class="text-xs text-gray-500">AED {{ record.cost }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Vehicles Tab -->
    <div *ngIf="selectedTab === 'vehicles'" class="space-y-6">
      
      <!-- Filters and Search -->
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Vehicle Management</h3>
          <div class="flex items-center space-x-2">
            <span class="text-sm text-gray-500">View:</span>
            <button 
              (click)="viewMode = 'grid'"
              [class]="viewMode === 'grid' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'"
              class="px-3 py-1 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">
              <i class="fas fa-th-large mr-1"></i>Grid
            </button>
            <button 
              (click)="viewMode = 'list'"
              [class]="viewMode === 'list' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'"
              class="px-3 py-1 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">
              <i class="fas fa-list mr-1"></i>List
            </button>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Search Vehicle</label>
            <input 
              type="text" 
              [ngModel]="searchTerm"
              (ngModelChange)="searchTerm = $event"
              placeholder="Vehicle number, make, model..."
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
            <select 
              [ngModel]="selectedStatus"
              (ngModelChange)="selectedStatus = $event"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="all">All Status</option>
              <option *ngFor="let status of vehicleStatuses" [value]="status.name">{{ status.name }}</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Vehicle Type</label>
            <select 
              [ngModel]="selectedType"
              (ngModelChange)="selectedType = $event"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="all">All Types</option>
              <option value="Transport">Transport</option>
              <option value="Construction">Construction</option>
              <option value="Specialized">Specialized</option>
            </select>
          </div>
          <div class="flex items-end">
            <button class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
              Apply Filters
            </button>
          </div>
        </div>
      </div>

      <!-- Grid View -->
      <div *ngIf="viewMode === 'grid'" class="space-y-6">
        <!-- Pagination Info for Grid -->
        <div class="bg-white px-6 py-3 rounded-lg shadow-md border border-gray-200 flex justify-between items-center">
          <div class="flex items-center space-x-4">
            <div class="text-sm text-gray-700">
              Showing <span class="font-medium">{{ ((currentPage - 1) * itemsPerPage) + 1 }}</span> to 
              <span class="font-medium">{{ getMin(currentPage * itemsPerPage, totalFilteredVehicles) }}</span> of 
              <span class="font-medium">{{ totalFilteredVehicles }}</span> vehicles
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm text-gray-600">Show:</label>
              <select 
                [ngModel]="itemsPerPage" 
                (ngModelChange)="changeItemsPerPage($any($event))"
                class="px-3 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option *ngFor="let option of itemsPerPageOptions" [value]="option">{{ option }}</option>
              </select>
              <span class="text-sm text-gray-600">per page</span>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button 
              (click)="previousPage()" 
              [disabled]="currentPage === 1"
              [class]="currentPage === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              <i class="fas fa-chevron-left"></i> Previous
            </button>
            <button 
              *ngFor="let page of getPageNumbers()"
              (click)="goToPage(page)"
              [class]="page === currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
              class="px-3 py-1 text-sm border border-gray-300 rounded-md">
              {{ page }}
            </button>
            <button 
              (click)="nextPage()" 
              [disabled]="currentPage === totalPages"
              [class]="currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              Next <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>

        <!-- Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div *ngFor="let vehicle of filteredVehicles" class="bg-white rounded-lg shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
            <div class="flex items-center">
              <i class="{{ getVehicleTypeIcon(vehicle.vehicleType.icon) }} text-2xl mr-3 text-blue-600"></i>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">{{ vehicle.vehicleNumber }}</h3>
                <p class="text-sm text-gray-500">{{ vehicle.make }} {{ vehicle.model }}</p>
              </div>
            </div>
              <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full" [class]="vehicle.currentStatus.bgColor + ' ' + vehicle.currentStatus.color">
                {{ vehicle.currentStatus.name }}
              </span>
            </div>

            <div class="space-y-3">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Type:</span>
                <span class="font-medium">{{ vehicle.vehicleType.name }}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Capacity:</span>
                <span class="font-medium">{{ vehicle.capacity }}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Location:</span>
                <span class="font-medium">{{ vehicle.location }}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Driver:</span>
                <span class="font-medium">{{ vehicle.assignedDriver?.name || 'Unassigned' }}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Fuel Efficiency:</span>
                <span class="font-medium">{{ vehicle.fuelEfficiency }} km/L</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Total KM:</span>
                <span class="font-medium">{{ vehicle.totalKm.toLocaleString() }}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Next Service:</span>
                <span class="font-medium" [class]="getServiceStatusColor(vehicle)">
                  {{ getDaysUntilService(vehicle) }} days
                </span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Maintenance:</span>
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full" [class]="getMaintenanceStatusColor(vehicle.maintenanceStatus)">
                  {{ vehicle.maintenanceStatus }}
                </span>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="flex space-x-2">
                <button (click)="openVehicleDetailsModal(vehicle)" class="flex-1 px-3 py-2 text-xs font-medium text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100">
                  View Details
                </button>
                <div class="flex-1">
                  <select (change)="updateVehicleStatus(vehicle, $any($event.target).value)" class="w-full px-3 py-2 text-xs font-medium text-green-600 bg-green-50 rounded-md hover:bg-green-100 border-0">
                    <option value="">Update Status</option>
                    <option *ngFor="let status of vehicleStatuses" [value]="status.name" [selected]="vehicle.currentStatus.name === status.name">
                      {{ status.name }}
                    </option>
                  </select>
                </div>
              </div>
              <div class="flex space-x-2 mt-2">
                <button (click)="openDriverAssignModal(vehicle)" class="flex-1 px-3 py-2 text-xs font-medium text-purple-600 bg-purple-50 rounded-md hover:bg-purple-100">
                  Assign Driver
                </button>
                <button (click)="openServiceModal(vehicle)" class="flex-1 px-3 py-2 text-xs font-medium text-yellow-600 bg-yellow-50 rounded-md hover:bg-yellow-100">
                  Schedule Service
                </button>
              </div>
              <div class="flex space-x-2 mt-2">
                <button (click)="removeDriver(vehicle)" *ngIf="vehicle.assignedDriver" class="flex-1 px-3 py-2 text-xs font-medium text-orange-600 bg-orange-50 rounded-md hover:bg-orange-100">
                  Remove Driver
                </button>
                <button (click)="deleteVehicle(vehicle)" class="flex-1 px-3 py-2 text-xs font-medium text-red-600 bg-red-50 rounded-md hover:bg-red-100">
                  Delete Vehicle
                </button>
              </div>
            </div>
          </div>
        </div>
        </div>

        <!-- Pagination Info for Grid (Bottom) -->
        <div class="bg-white px-6 py-3 rounded-lg shadow-md border border-gray-200 flex justify-between items-center">
          <div class="flex items-center space-x-4">
            <div class="text-sm text-gray-700">
              Page <span class="font-medium">{{ currentPage }}</span> of <span class="font-medium">{{ totalPages }}</span>
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm text-gray-600">Show:</label>
              <select 
                [ngModel]="itemsPerPage" 
                (ngModelChange)="changeItemsPerPage($any($event))"
                class="px-3 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option *ngFor="let option of itemsPerPageOptions" [value]="option">{{ option }}</option>
              </select>
              <span class="text-sm text-gray-600">per page</span>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button 
              (click)="previousPage()" 
              [disabled]="currentPage === 1"
              [class]="currentPage === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              <i class="fas fa-chevron-left"></i> Previous
            </button>
            <button 
              *ngFor="let page of getPageNumbers()"
              (click)="goToPage(page)"
              [class]="page === currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
              class="px-3 py-1 text-sm border border-gray-300 rounded-md">
              {{ page }}
            </button>
            <button 
              (click)="nextPage()" 
              [disabled]="currentPage === totalPages"
              [class]="currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              Next <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- List View -->
      <div *ngIf="viewMode === 'list'" class="bg-white rounded-lg shadow-md border border-gray-200">
        <!-- Pagination Info -->
        <div class="px-6 py-3 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
          <div class="flex items-center space-x-4">
            <div class="text-sm text-gray-700">
              Showing <span class="font-medium">{{ ((currentPage - 1) * itemsPerPage) + 1 }}</span> to 
              <span class="font-medium">{{ getMin(currentPage * itemsPerPage, totalFilteredVehicles) }}</span> of 
              <span class="font-medium">{{ totalFilteredVehicles }}</span> vehicles
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm text-gray-600">Show:</label>
              <select 
                [ngModel]="itemsPerPage" 
                (ngModelChange)="changeItemsPerPage($any($event))"
                class="px-3 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option *ngFor="let option of itemsPerPageOptions" [value]="option">{{ option }}</option>
              </select>
              <span class="text-sm text-gray-600">per page</span>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button 
              (click)="previousPage()" 
              [disabled]="currentPage === 1"
              [class]="currentPage === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              <i class="fas fa-chevron-left"></i> Previous
            </button>
            <button 
              *ngFor="let page of getPageNumbers()"
              (click)="goToPage(page)"
              [class]="page === currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
              class="px-3 py-1 text-sm border border-gray-300 rounded-md">
              {{ page }}
            </button>
            <button 
              (click)="nextPage()" 
              [disabled]="currentPage === totalPages"
              [class]="currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              Next <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fuel Efficiency</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total KM</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Next Service</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr *ngFor="let vehicle of filteredVehicles" class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <i class="{{ getVehicleTypeIcon(vehicle.vehicleType.icon) }} text-lg mr-3 text-blue-600"></i>
                    <div>
                      <div class="text-sm font-medium text-gray-900">{{ vehicle.vehicleNumber }}</div>
                      <div class="text-sm text-gray-500">{{ vehicle.make }} {{ vehicle.model }}</div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">{{ vehicle.vehicleType.name }}</div>
                  <div class="text-sm text-gray-500">{{ vehicle.capacity }}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full" [class]="vehicle.currentStatus.bgColor + ' ' + vehicle.currentStatus.color">
                    {{ vehicle.currentStatus.name }}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ vehicle.location }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ vehicle.assignedDriver?.name || 'Unassigned' }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ vehicle.fuelEfficiency }} km/L
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ vehicle.totalKm.toLocaleString() }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-medium" [class]="getServiceStatusColor(vehicle)">
                    {{ getDaysUntilService(vehicle) }} days
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <button (click)="openVehicleDetailsModal(vehicle)" class="text-blue-600 hover:text-blue-900">
                      <i class="fas fa-eye"></i>
                    </button>
                    <button (click)="openDriverAssignModal(vehicle)" class="text-purple-600 hover:text-purple-900">
                      <i class="fas fa-user-plus"></i>
                    </button>
                    <button (click)="openServiceModal(vehicle)" class="text-yellow-600 hover:text-yellow-900">
                      <i class="fas fa-wrench"></i>
                    </button>
                    <button (click)="deleteVehicle(vehicle)" class="text-red-600 hover:text-red-900">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Fuel Tab -->
    <div *ngIf="selectedTab === 'fuel'" class="space-y-6">
      
      <!-- Fuel Summary -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-orange-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-gas-pump text-orange-600 text-xl"></i>
            </div>
          </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-500">Today's Fuel</p>
              <p class="text-2xl font-bold text-orange-600">370L</p>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-dollar-sign text-green-600 text-xl"></i>
            </div>
          </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-500">Today's Cost</p>
              <p class="text-2xl font-bold text-green-600">AED 1,110</p>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-chart-line text-blue-600 text-xl"></i>
            </div>
          </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-500">Avg Efficiency</p>
              <p class="text-2xl font-bold text-blue-600">9.2 km/L</p>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-purple-50 rounded-lg flex items-center justify-center">
              <i class="fas fa-calendar-alt text-purple-600 text-xl"></i>
            </div>
          </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-500">This Month</p>
              <p class="text-2xl font-bold text-purple-600">11,100L</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Fuel Records Table -->
      <div class="bg-white rounded-lg shadow-md border border-gray-200">
        <!-- Pagination Info (Top) -->
        <div class="px-6 py-3 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
          <div class="flex items-center space-x-4">
            <h3 class="text-lg font-semibold text-gray-900">Recent Fuel Entries</h3>
            <div class="text-sm text-gray-700">
              Showing <span class="font-medium">{{ ((fuelCurrentPage - 1) * fuelItemsPerPage) + 1 }}</span> to 
              <span class="font-medium">{{ getMin(fuelCurrentPage * fuelItemsPerPage, fuelRecords.length) }}</span> of 
              <span class="font-medium">{{ fuelRecords.length }}</span> records
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <label class="text-sm text-gray-600">Show:</label>
            <select 
              [ngModel]="fuelItemsPerPage" 
              (ngModelChange)="changeFuelItemsPerPage($any($event))"
              class="px-3 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option *ngFor="let option of fuelItemsPerPageOptions" [value]="option">{{ option }}</option>
            </select>
            <span class="text-sm text-gray-600">per page</span>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fuel Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">KM Reading</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cost</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr *ngFor="let record of paginatedFuelRecords" class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <i class="{{ getVehicleTypeIconForRecord(record.vehicleId) }} text-lg mr-2 text-blue-600"></i>
                    <span class="text-sm font-medium text-gray-900">AF-{{ record.vehicleId.padStart(3, '0') }}</span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ formatDate(record.date) }}<br>
                  <span class="text-gray-500">{{ record.time }}</span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-orange-600">
                  {{ record.fuelAmount }}L
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ record.kmReading.toLocaleString() }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-green-600">
                  AED {{ record.cost }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ record.location }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {{ getDriverNameForRecord(record.driverId) }}
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination Info (Bottom) -->
        <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 flex justify-between items-center">
          <div class="text-sm text-gray-700">
            Page <span class="font-medium">{{ fuelCurrentPage }}</span> of <span class="font-medium">{{ totalFuelPages }}</span>
          </div>
          <div class="flex items-center space-x-2">
            <button 
              (click)="previousFuelPage()" 
              [disabled]="fuelCurrentPage === 1"
              [class]="fuelCurrentPage === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              <i class="fas fa-chevron-left"></i> Previous
            </button>
            <button 
              *ngFor="let page of getFuelPageNumbers()"
              (click)="goToFuelPage(page)"
              [class]="page === fuelCurrentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
              class="px-3 py-1 text-sm border border-gray-300 rounded-md">
              {{ page }}
            </button>
            <button 
              (click)="nextFuelPage()" 
              [disabled]="fuelCurrentPage === totalFuelPages"
              [class]="fuelCurrentPage === totalFuelPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-200'"
              class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md">
              Next <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Routes Tab -->
    <div *ngIf="selectedTab === 'routes'" class="space-y-6">
      
      <!-- Routes Overview -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div *ngFor="let route of routes" class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">{{ route.name }}</h3>
            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
              {{ route.type }}
            </span>
          </div>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">From:</span>
              <span class="font-medium">{{ route.startLocation }}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">To:</span>
              <span class="font-medium">{{ route.endLocation }}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Distance:</span>
              <span class="font-medium">{{ route.distance }} km</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Duration:</span>
              <span class="font-medium">{{ route.estimatedTime }} min</span>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-gray-200">
            <button (click)="showRouteDetails(route.name)" class="w-full px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100">
              View Details
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Maintenance Tab -->
    <div *ngIf="selectedTab === 'maintenance'" class="space-y-6">
      
      <!-- Maintenance Alerts -->
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Maintenance Alerts</h3>
        <div class="space-y-4">
          <div *ngFor="let vehicle of getVehiclesDueForService()" class="flex items-center justify-between p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
            <div class="flex items-center">
              <i class="{{ getVehicleTypeIcon(vehicle.vehicleType.icon) }} text-2xl mr-3 text-blue-600"></i>
              <div>
                <p class="text-sm font-medium text-gray-900">{{ vehicle.vehicleNumber }}</p>
                <p class="text-xs text-gray-500">{{ vehicle.make }} {{ vehicle.model }}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-medium text-yellow-800">Service Due</p>
              <p class="text-xs text-yellow-600">{{ getDaysUntilService(vehicle) }} days</p>
              <button (click)="openServiceModal(vehicle)" class="mt-2 px-2 py-1 text-xs bg-yellow-600 text-white rounded hover:bg-yellow-700">
                Schedule Now
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Maintenance History -->
      <div class="bg-white rounded-lg shadow-md border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Maintenance History</h3>
        </div>
        <div class="p-6">
          <div class="text-center py-12">
            <i class="fas fa-tools text-gray-400 text-4xl mx-auto mb-4"></i>
            <p class="text-gray-500">Maintenance history will be displayed here</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Add Vehicle Modal -->
<div *ngIf="showAddVehicleModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Add New Vehicle</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Vehicle Number *</label>
          <input type="text" [(ngModel)]="newVehicle.vehicleNumber" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Vehicle Type *</label>
          <select [(ngModel)]="newVehicle.vehicleType" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option *ngFor="let type of vehicleTypes" [ngValue]="type">{{ type.name }}</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Make *</label>
            <input type="text" [(ngModel)]="newVehicle.make" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Model *</label>
            <input type="text" [(ngModel)]="newVehicle.model" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Capacity</label>
          <input type="text" [(ngModel)]="newVehicle.capacity" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Registration Number</label>
          <input type="text" [(ngModel)]="newVehicle.registrationNumber" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
      </div>
      <div class="flex justify-end space-x-3 mt-6">
        <button (click)="closeAddVehicleModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
          Cancel
        </button>
        <button (click)="addVehicle()" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
          Add Vehicle
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Fuel Entry Modal -->
<div *ngIf="showFuelEntryModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Add Fuel Entry</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Vehicle *</label>
          <select [(ngModel)]="newFuelRecord.vehicleId" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="">Select Vehicle</option>
            <option *ngFor="let vehicle of vehicles" [value]="vehicle.id">{{ vehicle.vehicleNumber }} - {{ vehicle.make }} {{ vehicle.model }}</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Date</label>
            <input type="date" [(ngModel)]="newFuelRecord.date" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Time</label>
            <input type="time" [(ngModel)]="newFuelRecord.time" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Fuel Amount (L) *</label>
          <input type="number" [(ngModel)]="newFuelRecord.fuelAmount" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">KM Reading *</label>
          <input type="number" [(ngModel)]="newFuelRecord.kmReading" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Cost (AED)</label>
          <input type="number" [(ngModel)]="newFuelRecord.cost" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Location</label>
          <input type="text" [(ngModel)]="newFuelRecord.location" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Driver</label>
          <select [(ngModel)]="newFuelRecord.driverId" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="">Select Driver</option>
            <option *ngFor="let driver of drivers" [value]="driver.id">{{ driver.name }}</option>
          </select>
        </div>
      </div>
      <div class="flex justify-end space-x-3 mt-6">
        <button (click)="closeFuelEntryModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
          Cancel
        </button>
        <button (click)="addFuelRecord()" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">
          Add Fuel Entry
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Service Modal -->
<div *ngIf="showServiceModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Schedule Service</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Vehicle *</label>
          <select [(ngModel)]="newServiceRecord.vehicleId" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="">Select Vehicle</option>
            <option *ngFor="let vehicle of vehicles" [value]="vehicle.id">{{ vehicle.vehicleNumber }} - {{ vehicle.make }} {{ vehicle.model }}</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Service Type</label>
          <select [(ngModel)]="newServiceRecord.serviceType" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="Regular">Regular Service</option>
            <option value="Major">Major Service</option>
            <option value="Emergency">Emergency Repair</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Description *</label>
          <textarea [(ngModel)]="newServiceRecord.description" rows="3" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Cost (AED)</label>
          <input type="number" [(ngModel)]="newServiceRecord.cost" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Next Service Date</label>
          <input type="date" [(ngModel)]="newServiceRecord.nextServiceDate" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
        </div>
      </div>
      <div class="flex justify-end space-x-3 mt-6">
        <button (click)="closeServiceModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
          Cancel
        </button>
        <button (click)="scheduleService()" class="px-4 py-2 bg-yellow-600 text-white rounded-md hover:bg-yellow-700">
          Schedule Service
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Driver Assignment Modal -->
<div *ngIf="showDriverAssignModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Assign Driver</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Vehicle</label>
          <select [(ngModel)]="selectedVehicle" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
            <option value="">Select Vehicle</option>
            <option *ngFor="let vehicle of getAvailableVehicles()" [ngValue]="vehicle">{{ vehicle.vehicleNumber }} - {{ vehicle.make }} {{ vehicle.model }}</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Available Drivers</label>
          <div class="mt-2 space-y-2 max-h-40 overflow-y-auto">
            <div *ngFor="let driver of getAvailableDrivers()" 
                 (click)="selectedDriver = driver"
                 [class]="selectedDriver?.id === driver.id ? 'bg-blue-100 border-blue-500' : 'bg-gray-50 border-gray-200'"
                 class="p-3 border rounded-md cursor-pointer hover:bg-gray-100">
              <div class="flex justify-between items-center">
                <div>
                  <p class="font-medium">{{ driver.name }}</p>
                  <p class="text-sm text-gray-500">{{ driver.licenseNumber }}</p>
                </div>
                <div class="text-sm text-gray-500">{{ driver.phone }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex justify-end space-x-3 mt-6">
        <button (click)="closeDriverAssignModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
          Cancel
        </button>
        <button (click)="assignDriver()" class="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700">
          Assign Driver
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Vehicle Details Modal - Enhanced -->
<div *ngIf="showVehicleDetailsModal && selectedVehicle" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-5 mx-auto p-6 border w-full max-w-6xl shadow-2xl rounded-xl bg-white mb-10 max-h-[95vh] overflow-y-auto">
    <!-- Header with Vehicle Icon -->
    <div class="flex items-center justify-between mb-6 pb-4 border-b-2 border-gray-200">
      <div class="flex items-center space-x-4">
        <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
          <i class="{{ getVehicleTypeIcon(selectedVehicle.vehicleType.icon) }} text-4xl text-white"></i>
        </div>
        <div>
          <h3 class="text-3xl font-bold text-gray-900">{{ selectedVehicle.vehicleNumber }}</h3>
          <p class="text-md text-gray-600">{{ selectedVehicle.make }} {{ selectedVehicle.model }} ({{ selectedVehicle.year }})</p>
          <p class="text-sm text-gray-500">{{ selectedVehicle.vehicleType.name }} - {{ selectedVehicle.vehicleType.category }}</p>
        </div>
      </div>
      <div class="flex flex-col items-end space-y-2">
        <span class="inline-flex px-4 py-2 text-sm font-bold rounded-lg shadow-md" [class]="selectedVehicle.currentStatus.bgColor + ' ' + selectedVehicle.currentStatus.color">
          <i class="fas fa-circle mr-2"></i>{{ selectedVehicle.currentStatus.name }}
        </span>
        <button (click)="closeVehicleDetailsModal()" class="text-gray-400 hover:text-gray-700 text-2xl">
          <i class="fas fa-times-circle"></i>
        </button>
      </div>
    </div>

    <!-- Main Content Grid - 4 Columns -->
    <div class="grid grid-cols-4 gap-4 mb-6">
      <!-- Column 1: Basic Information -->
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-5 rounded-xl shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-info-circle text-blue-600 mr-2"></i> Basic Info
        </h4>
        <div class="space-y-3">
          <div>
            <span class="text-xs text-gray-600 block">Capacity</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.capacity }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Fuel Type</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.fuelType }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Registration</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.registrationNumber }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Category</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.vehicleType.category }}</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Location & Status -->
      <div class="bg-gradient-to-br from-green-50 to-green-100 p-5 rounded-xl shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-map-marker-alt text-green-600 mr-2"></i> Location
        </h4>
        <div class="space-y-3">
          <div>
            <span class="text-xs text-gray-600 block">Current Location</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.location }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Assigned Route</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.route?.name || 'No Route' }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Total Distance</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.totalKm.toLocaleString() }} km</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Maintenance</span>
            <span class="inline-flex px-2 py-1 text-xs font-bold rounded-full" [class]="getMaintenanceStatusColor(selectedVehicle.maintenanceStatus)">
              {{ selectedVehicle.maintenanceStatus }}
            </span>
          </div>
        </div>
      </div>

      <!-- Column 3: Driver Information -->
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 p-5 rounded-xl shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-user text-purple-600 mr-2"></i> Driver
        </h4>
        <div *ngIf="selectedVehicle.assignedDriver" class="space-y-3">
          <div>
            <span class="text-xs text-gray-600 block">Driver Name</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.assignedDriver.name }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Phone</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.assignedDriver.phone }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">License Number</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.assignedDriver.licenseNumber }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Status</span>
            <span class="inline-flex px-2 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800">
              {{ selectedVehicle.assignedDriver.status }}
            </span>
          </div>
        </div>
        <div *ngIf="!selectedVehicle.assignedDriver" class="text-center py-8">
          <i class="fas fa-user-slash text-4xl text-gray-300 mb-2"></i>
          <p class="text-sm text-gray-500">No Driver Assigned</p>
        </div>
      </div>

      <!-- Column 4: Fuel Efficiency -->
      <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-5 rounded-xl shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-gas-pump text-orange-600 mr-2"></i> Fuel Stats
        </h4>
        <div class="space-y-3">
          <div>
            <span class="text-xs text-gray-600 block">Efficiency</span>
            <span class="text-2xl font-bold text-green-600">{{ selectedVehicle.fuelEfficiency.toFixed(1) }}</span>
            <span class="text-xs text-gray-600"> km/L</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Total Records</span>
            <span class="text-sm font-bold text-gray-900">{{ getFuelRecordsForVehicle(selectedVehicle.id).length }}</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block">Last Fuel Date</span>
            <span class="text-sm font-bold text-gray-900">{{ selectedVehicle.lastFuelDate ? formatDate(selectedVehicle.lastFuelDate) : 'N/A' }}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Service & Insurance Section -->
    <div class="grid grid-cols-2 gap-4 mb-6">
      <!-- Service Information -->
      <div class="bg-gradient-to-r from-yellow-50 to-amber-50 p-5 rounded-xl border-2 border-yellow-200 shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-wrench text-yellow-600 mr-2"></i> Service Schedule
        </h4>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <span class="text-xs text-gray-600 block mb-1">Last Service</span>
            <span class="text-sm font-bold text-gray-900 block">{{ formatDate(selectedVehicle.lastServiceDate) }}</span>
            <span class="text-xs text-gray-500">{{ getDaysUntil(selectedVehicle.lastServiceDate) * -1 }} days ago</span>
          </div>
          <div>
            <span class="text-xs text-gray-600 block mb-1">Next Service</span>
            <span class="text-sm font-bold block" [class]="getDaysUntilService(selectedVehicle) <= 0 ? 'text-red-600' : 'text-gray-900'">
              {{ formatDate(selectedVehicle.nextServiceDate) }}
            </span>
            <span class="text-xs font-bold px-2 py-1 rounded-full inline-block mt-1" [class]="getServiceStatusColor(selectedVehicle)">
              {{ getDaysUntilService(selectedVehicle) }} days
            </span>
          </div>
        </div>
      </div>

      <!-- Insurance Information -->
      <div class="bg-gradient-to-r from-indigo-50 to-blue-50 p-5 rounded-xl border-2 border-indigo-200 shadow-md">
        <h4 class="font-bold text-gray-900 flex items-center mb-4 text-lg">
          <i class="fas fa-shield-alt text-indigo-600 mr-2"></i> Insurance
        </h4>
        <div>
          <span class="text-xs text-gray-600 block mb-1">Insurance Expiry Date</span>
          <span class="text-sm font-bold text-gray-900 block">{{ formatDate(selectedVehicle.insuranceExpiry) }}</span>
          <span class="text-xs font-semibold px-3 py-1 rounded-full inline-block mt-2" 
                [class]="getDaysUntil(selectedVehicle.insuranceExpiry) < 30 ? 'bg-red-100 text-red-700' : getDaysUntil(selectedVehicle.insuranceExpiry) < 90 ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700'">
            <i class="fas fa-clock mr-1"></i>{{ getDaysUntil(selectedVehicle.insuranceExpiry) }} days remaining
          </span>
        </div>
      </div>
    </div>

    <!-- Recent Fuel Records - Enhanced -->
    <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-6 rounded-xl border border-gray-200 shadow-md">
      <h4 class="font-bold text-gray-900 mb-4 flex items-center justify-between text-lg">
        <span><i class="fas fa-history text-blue-600 mr-2"></i> Recent Fuel Fill-ups (Last 5)</span>
        <span class="text-sm text-gray-600">Total: {{ getFuelRecordsForVehicle(selectedVehicle.id).length }} records</span>
      </h4>
      <div class="grid grid-cols-1 gap-3">
        <div *ngFor="let record of getFuelRecordsForVehicle(selectedVehicle.id).slice(0, 5)" 
             class="flex justify-between items-center p-4 bg-white rounded-lg border-l-4 border-orange-500 hover:shadow-lg transition-all">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center shadow-md">
              <i class="fas fa-gas-pump text-white text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900">{{ formatDate(record.date) }} <span class="text-orange-600">@ {{ record.time }}</span></p>
              <p class="text-xs text-gray-600 flex items-center mt-1">
                <i class="fas fa-map-marker-alt mr-1 text-red-500"></i>{{ record.location }}
              </p>
              <p class="text-xs text-gray-600 flex items-center">
                <i class="fas fa-user mr-1 text-blue-500"></i>{{ getDriverNameForRecord(record.driverId) }}
              </p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-2xl font-bold text-orange-600">{{ record.fuelAmount }}L</p>
            <p class="text-md font-semibold text-green-600">AED {{ record.cost }}</p>
            <p class="text-xs text-gray-500"><i class="fas fa-tachometer-alt mr-1"></i>{{ record.kmReading.toLocaleString() }} km</p>
          </div>
        </div>
      </div>
      <p *ngIf="getFuelRecordsForVehicle(selectedVehicle.id).length === 0" class="text-center text-gray-500 py-8">
        <i class="fas fa-inbox text-4xl mb-2 text-gray-300"></i>
        <br>No fuel records available for this vehicle
      </p>
    </div>

    <!-- Action Buttons Footer -->
    <div class="flex justify-between items-center mt-6 pt-4 border-t-2 border-gray-200">
      <div class="flex space-x-3">
        <button (click)="openFuelEntryModal(); closeVehicleDetailsModal()" class="px-5 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white rounded-lg hover:from-orange-600 hover:to-orange-700 shadow-md font-semibold">
          <i class="fas fa-gas-pump mr-2"></i>Add Fuel Entry
        </button>
        <button (click)="openServiceModal(selectedVehicle)" class="px-5 py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-lg hover:from-yellow-600 hover:to-yellow-700 shadow-md font-semibold">
          <i class="fas fa-wrench mr-2"></i>Schedule Service
        </button>
        <button (click)="openDriverAssignModal(selectedVehicle)" class="px-5 py-3 bg-gradient-to-r from-purple-500 to-purple-600 text-white rounded-lg hover:from-purple-600 hover:to-purple-700 shadow-md font-semibold">
          <i class="fas fa-user-plus mr-2"></i>Assign Driver
        </button>
      </div>
      <button (click)="closeVehicleDetailsModal()" class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 shadow-md font-semibold">
        <i class="fas fa-times mr-2"></i>Close
      </button>
    </div>
  </div>
</div>


